# Todas las variables son OPCIONALES. Sin ninguna, la app usa datos locales (src/data/mock).

# Origen de datos: "mock" (por defecto) o "drupal"
DATA_SOURCE=mock

# Solo si DATA_SOURCE=drupal (si Drupal falla, la app vuelve automáticamente a los datos locales)
